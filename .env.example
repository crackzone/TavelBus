# Application Environment
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_super_secret_key_in_production_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=https://your-frontend.onrender.com,http://localhost:5173

# Database Configuration (PostgreSQL Async)
# On Render: Use Internal Database URL starting with postgresql:// or postgres://
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/travelbus_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_PRE_PING=true

# AI & Cloud Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GCP_PROJECT_ID=travelbus-manager-dev
GCP_LOCATION=us-central1
PUBSUB_TOPIC_BUS_LOCATIONS=bus-location-events
PUBSUB_SUBSCRIPTION_TRACKING=tracking-worker-subscription
GCS_BUCKET_DOCUMENTS=travelbus-policy-docs
GOOGLE_MAPS_API_KEY=
