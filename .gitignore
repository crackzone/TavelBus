*.class
*.so
.Python
build/
develop-eggs/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
ENV/
backend/.venv/
backend/venv/

# Testing & Linters
.pytest_cache/
.coverage
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.oxlint_cache/

# Databases & Scratch
*.sqlite
*.db
.tmp/
backend/.tmp/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo
.cursor/

# OS artifacts
Thumbs.db
Desktop.ini
.DS_Store
